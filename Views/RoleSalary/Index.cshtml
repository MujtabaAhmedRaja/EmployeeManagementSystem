@model IEnumerable<EMS.Models.Salary>

@{
    ViewData["Title"] = "Role & Salary History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Role & Salary Management</h2>
    <div>
        <a asp-action="AssignRole" class="btn btn-primary">Assign Role</a>
        <a asp-action="SetSalary" class="btn btn-secondary">Set Salary</a>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Employee</th>
            <th>Role</th>
            <th>Salary</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var salary in Model)
        {
            <tr>
                <td>@salary.Employee?.EName</td>
                <td>@salary.Role?.RoleName</td>
                <td>@salary.Amount.ToString("C0")</td>
                <td>
                    <a asp-action="UpdateSalary" asp-route-employeeId="@salary.Eid" asp-route-roleId="@salary.RoleId" class="btn btn-sm btn-warning">Update</a>
                </td>
            </tr>
        }
    </tbody>
</table>
