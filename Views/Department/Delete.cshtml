@model EMS.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h2>Delete Department</h2>
<h4 class="text-danger">Are you sure you want to delete this department?</h4>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Department Name</dt>
        <dd class="col-sm-9">@Model.DepName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input asp-for="DepId" type="hidden" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
