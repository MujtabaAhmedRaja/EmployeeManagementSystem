@model EMS.Models.Role

@{
    ViewData["Title"] = "Edit Role";
}

<h2>Edit Role</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" class="shadow p-4 rounded bg-light">
            <input type="hidden" asp-for="RoleId" />
            <div class="form-group mb-3">
                <label asp-for="RoleName" class="form-label font-weight-bold"></label>
                <input asp-for="RoleName" class="form-control" />
                <span asp-validation-for="RoleName" class="text-danger"></span>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
