@model IEnumerable<EMS.Models.Attendance>

@{
    ViewData["Title"] = "Attendance History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Attendance History</h2>
    <div>
        <a asp-action="Record" class="btn btn-primary">Record Attendance</a>
        <a asp-action="ApplyLeave" class="btn btn-secondary">Apply for Leave</a>
        <a asp-action="ManageLeaves" class="btn btn-info">Manage Leaves</a>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Date</th>
            <th>Employee Name</th>
            <th>Status</th>
            <th>Remarks</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendance in Model)
        {
            <tr>
                <td>@attendance.AttDate:yyyy-MM-dd</td>
                <td>@attendance.Employee?.EName</td>
                <td>
                    <span class="badge @(attendance.Status == "Present" ? "bg-success" : attendance.Status == "Absent" ? "bg-danger" : "bg-warning")">@attendance.Status</span>
                </td>
                <td>@attendance.Status</td>
            </tr>
        }
    </tbody>
</table>
