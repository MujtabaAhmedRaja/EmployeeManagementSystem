@model EMS.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="form-group mb-3">
                <label asp-for="EName"></label>
                <input asp-for="EName" class="form-control" />
                <span asp-validation-for="EName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EAge"></label>
                <input asp-for="EAge" class="form-control" />
                <span asp-validation-for="EAge" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ECity"></label>
                <input asp-for="ECity" class="form-control" />
                <span asp-validation-for="ECity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="DepId"></label>
                <select asp-for="DepId" asp-items="ViewBag.Departments" class="form-control"></select>
                <span asp-validation-for="DepId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
