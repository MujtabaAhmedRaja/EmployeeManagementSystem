@model IEnumerable<EMS.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Employee Management</h2>
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Age</th>
            <th>City</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Eid</td>
                <td>@employee.EName</td>
                <td>@employee.EAge</td>
                <td>@employee.ECity</td>
                <td>@employee.Department?.DepName</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@employee.Eid" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@employee.Eid" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
